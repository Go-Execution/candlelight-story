# Stripe Public Key (Safe for frontend — starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Secret Key (Server-only — starts with sk_test_ or sk_live_)
# NEVER expose with VITE_ prefix and NEVER commit real keys to Git
STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret (Optional for local dev, required for live webhooks — starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Public Site URL (Used for Stripe success_url and cancel_url redirects)
PUBLIC_SITE_URL=http://localhost:3000
