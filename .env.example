# ============================================================================
# 1. SUPABASE CONFIGURATION (Frontend + Backend)
# Find these in: Supabase Dashboard -> Project Settings -> API
# ============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only Supabase Service Role Key (Used by server webhook to update orders securely)
# NEVER prefix this with VITE_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================================
# 2. STRIPE CONFIGURATION
# Find these in: Stripe Dashboard -> Developers -> API keys
# ============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Server-only Stripe Secret Key (NEVER prefix with VITE_ and NEVER commit to Git)
STRIPE_SECRET_KEY=sk_test_...

# Server-only Stripe Webhook Signing Secret (Stripe Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Public Site URL (Used for Stripe success/cancel redirects when Origin header is absent)
PUBLIC_SITE_URL=http://localhost:3000
